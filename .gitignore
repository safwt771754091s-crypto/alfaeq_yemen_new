# Generated Flutter project files are created by CI.
.dart_tool/
build/
.pub-cache/
android/.gradle/
android/local.properties
android/key.properties
android/app/*.keystore
android/app/*.jks
*.keystore
*.jks
web/

# AI provider secrets (local deploy helper)
.env.ai

# Supabase CLI scratch
supabase/.temp/

# Local tooling artifacts
.flutter-plugins-dependencies
.openhands/

# Agent scratch space
.agent_tmp/

# Local Android release keystore backup (NEVER commit - losing/leaking it
# breaks Play updates and allows forged releases)
.secrets-backup/
