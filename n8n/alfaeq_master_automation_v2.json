    {
      "parameters": {
        "jsCode": "const input=$input.first()?.json??{}; const body=input.body&&typeof input.body==='object'?input.body:input; const rawHeaders=input.headers&&typeof input.headers==='object'?input.headers:{}; const headers=Object.fromEntries(Object.entries(rawHeaders).map(([k,v])=>[String(k).toLowerCase(),String(v??'')])); const secret=headers['x-alfaeq-automation-secret']||''; const expected=$vars?.ALFAEQ_N8N_SHARED_SECRET||''; if(!expected) throw new Error('ALFAEQ_N8N_SHARED_SECRET variable is missing'); if(secret!==expected) throw new Error('Invalid Alfaeq automation secret'); for(const key of ['eventId','eventType','occurredAt']) if(!body[key]) throw new Error('Missing event field: '+key); return [{json:{source:String(body.source||'alfaeq_yemen_new'),version:Number(body.version||1),eventId:String(body.eventId),eventType:String(body.eventType),occurredAt:String(body.occurredAt),data:body.data??body.payload??{}}}];"
      },
