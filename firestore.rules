rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function merchant() { return signedIn() && request.auth.token.role == 'merchant'; }
    function driver() { return signedIn() && request.auth.token.role == 'driver'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if admin() || (owner(uid) && request.resource.data.role == 'customer' && request.resource.data.uid == request.auth.uid);
      allow update: if admin() || (owner(uid) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid);
      allow delete: if admin();
    }

    match /sections/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /stores/{id} {
      allow read: if resource.data.status == 'approved' || admin() || (merchant() && resource.data.ownerId == request.auth.uid);
      allow create: if admin() || (merchant() && request.resource.data.ownerId == request.auth.uid);
      allow update: if admin() || (merchant() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid);
      allow delete: if admin();
    }

    match /products/{id} {
      allow read: if resource.data.status == 'active' || admin() || (merchant() && resource.data.ownerId == request.auth.uid);
      allow create: if admin() || (merchant() && request.resource.data.ownerId == request.auth.uid);
      allow update: if admin() || (merchant() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid);
      allow delete: if admin() || (merchant() && resource.data.ownerId == request.auth.uid);
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid) || (merchant() && resource.data.merchantId == request.auth.uid) || (driver() && resource.data.driverId == request.auth.uid);
      allow update: if admin() || (driver() && resource.data.driverId == request.auth.uid) || (merchant() && resource.data.merchantId == request.auth.uid);
      allow delete: if admin();
    }

    match /deliveryEvents/{id} {
      allow read: if admin() || signedIn();
      allow create: if admin() || driver();
      allow update, delete: if admin();
    }

    match /payments/{id} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if admin();
      allow delete: if admin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
  }
}
