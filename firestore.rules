rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }
    function ownerRole() { return signedIn() && (request.auth.token.owner == true || request.auth.token.role == 'owner'); }
    function developer() { return signedIn() && (request.auth.token.role == 'developer' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'); }
    function staff() { return admin() || ownerRole(); }
    function merchant() { return signedIn() && (request.auth.token.role == 'merchant' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant'); }
    function driver() { return signedIn() && (request.auth.token.role == 'driver' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if self(uid) || staff() || developer();
      allow create: if staff() || (self(uid) && request.resource.data.role == 'customer' && request.resource.data.uid == request.auth.uid);
      allow update: if staff() || (self(uid) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid);
      allow delete: if staff();
    }

    match /sections/{id} {
      allow read: if true;
      allow create, update, delete: if staff();
    }

    match /stores/{id} {
      allow read: if resource.data.status == 'approved' || staff() || developer() || (merchant() && resource.data.ownerId == request.auth.uid);
      allow create: if staff() || (merchant() && request.resource.data.ownerId == request.auth.uid);
      allow update: if staff() || (merchant() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if staff();
    }

    match /products/{id} {
      allow read: if resource.data.status == 'active' || staff() || developer() || (merchant() && resource.data.ownerId == request.auth.uid);
      allow create: if staff() || (merchant() && request.resource.data.ownerId == request.auth.uid);
      allow update: if staff() || (merchant() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.storeId == resource.data.storeId);
      allow delete: if staff() || (merchant() && resource.data.ownerId == request.auth.uid);
    }

    match /carts/{uid} {
      allow read, create, update: if self(uid) && request.resource.data.ownerId == request.auth.uid;
      allow delete: if self(uid);
    }

    match /drivers/{uid} {
      allow read: if staff() || developer() || self(uid);
      allow create: if staff() || (driver() && self(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.approved == false);
      allow update: if staff()
        || (driver() && self(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'currentLocation', 'lastSeenAt', 'updatedAt', 'activeOrderCount'])
          && request.resource.data.activeOrderCount >= 0
          && request.resource.data.activeOrderCount <= resource.data.activeOrderCount);
      allow delete: if staff();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if staff() || developer()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (merchant() && request.auth.uid in resource.data.merchantIds)
        || (merchant() && resource.data.merchantId == request.auth.uid)
        || (driver() && resource.data.driverId == request.auth.uid);
      allow update: if staff()
        || (merchant() && request.auth.uid in resource.data.merchantIds && request.resource.data.customerId == resource.data.customerId && request.resource.data.merchantIds == resource.data.merchantIds)
        || (merchant() && resource.data.merchantId == request.auth.uid && request.resource.data.customerId == resource.data.customerId && request.resource.data.merchantId == resource.data.merchantId)
        || (driver() && resource.data.driverId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'deliveryLocation', 'updatedAt', 'status', 'deliveredAt'])
          && request.resource.data.deliveryStatus in ['assigned', 'picked_up', 'out_for_delivery', 'delivered', 'failed']);
      allow delete: if staff();
    }

    match /deliveryEvents/{id} {
      allow read: if staff() || developer() || (driver() && resource.data.driverId == request.auth.uid);
      allow create: if staff() || (driver() && request.resource.data.driverId == request.auth.uid);
      allow update, delete: if staff();
    }

    match /payments/{id} {
      allow read: if staff() || developer() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if staff();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if staff() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if staff();
    }

    match /securityReports/{id} {
      allow read: if staff() || developer();
      allow create: if staff() || (developer() && request.resource.data.actorUid == request.auth.uid);
      allow update, delete: if staff();
    }

    match /auditLogs/{id} {
      allow read: if staff() || developer();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.result is string
        && request.resource.data.source is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
